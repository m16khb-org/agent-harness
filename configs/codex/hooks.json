{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook post-compact --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook post-tool-use",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook pre-compact",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook pre-tool-use --enforce-worktree --enforce-korean-remote-artifacts --enforce-vcs-issue-linking --enforce-staged-checks --enforce-gitops-kubectl",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook session-start --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook stop --enforce-numbered-next-actions --relay-next-action-judgement",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook user-prompt --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
