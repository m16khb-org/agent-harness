{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook post-compact --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook post-tool-use",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook pre-compact",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook pre-tool-use --enforce-codegraph-search",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook session-start --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook stop",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook user-prompt --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
