{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook post-compact --host claude",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook session-start --host claude",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
