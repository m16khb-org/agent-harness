{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook post-tool-use",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook stop",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook user-prompt",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
