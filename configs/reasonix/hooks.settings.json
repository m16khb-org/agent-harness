{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook post-tool-use",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook pre-compact",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook pre-tool-use --host reasonix --enforce-worktree --enforce-korean-remote-artifacts --enforce-vcs-issue-linking --enforce-staged-checks --enforce-gitops-kubectl",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PromptSubmit": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook user-prompt --host reasonix",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook session-end --host reasonix",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook session-start --host reasonix",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'./bin/agent-harness' hook stop --host reasonix --enforce-numbered-next-actions --relay-next-action-judgement",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
