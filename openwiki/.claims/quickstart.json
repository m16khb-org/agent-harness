    {
      "id": "claim_3c80ba9078e54f728082b1a1beaada4a",
      "statement": "The minimum completion gate applies to every change, including docs-only edits: `go test ./... -count=1`, `go build -o bin/agent-harness ./cmd/harness`, `agent-harness docs --json`, `agent-harness inspect --json`, and `agent-harness self-verify --seed=100 --target-score=95 --llm-eval=false --json`.",
      "evidence": [
