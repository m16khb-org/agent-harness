  "claims": [
    {
      "id": "claim_7e6d4fc3d8ed4069bfaf0eaa64f7c644",
      "statement": "agent-harness is a hybrid: one host-neutral Go core (built from `cmd/harness` with `internal/...`) surrounded by thin adapters — Codex, Claude Code, and Omo native install only user-level skills, MCP registration, and lifecycle hooks that call the same `agent-harness` binary instead of embedding harness behavior.",
      "evidence": [
        {
          "resource": "repo://.agent-harness/ARCHITECTURE.md#L12-L16",
          "version": "repo-lines-v1:sha256:a4499270825324a7fd2927539a26edfbd886dd9298499234d9fabb72bd66ec86:"
        },
        {
          "resource": "repo://AGENTS.md#L88-L91",
          "version": "repo-lines-v1:sha256:26ff2a99a117fc2d51f6f6bf2ad224018b8f11e6ee8a309858273436c204eb16:"
        },
