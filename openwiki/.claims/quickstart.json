        }
      ]
    },
    {
      "id": "claim_bd0868a9f40b447dac981f0e7f28af03",
      "statement": "Every CLI invocation enters at `cmd/harness/main.go`, delegates to `harnessapp.RunRootCommand`, wires concrete dependencies into leaf CLI packages exactly once via `wireDependencies` under a `sync.Once` (explicit composition-root wiring rather than `init()` side effects), and then dispatches through `rootcmd.Command.Run`, which owns dispatch, help/version handling, usage printing, and exit-code policy.",
      "evidence": [
        {
          "resource": "repo://cmd/harness/harnessapp/root_command_facade.go#L17-L33",
