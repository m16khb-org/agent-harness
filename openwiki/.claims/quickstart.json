        }
      ]
    },
    {
      "id": "claim_2b020290c94c4b32b32704ca321ad3e4",
      "statement": "Five boundary commitments hold across the harness: core behavior lives in the Go core (not host plugins or hooks); CLI JSON, MCP responses, and daemon responses keep identical semantics; host adapters cannot bypass authentication, command policy, or workspace boundaries; default hooks provide only the SessionStart static project-doc context and never block tool calls or create issues/PRs, edit files, or run tests; and the worker handles lifecycle jobs plus policy-gated read-only evidence commands rather than acting as a general writable shell runner.",
      "evidence": [
        {
          "resource": "repo://.agent-harness/OPERATIONS.md#L73-L93",
          "version": "repo-lines-v1:sha256:ced449a0801443eb9f2818d75b8952721fa5409863c817a968bccdfd07a59024:"
