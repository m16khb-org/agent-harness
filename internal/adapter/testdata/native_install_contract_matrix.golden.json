              "content_sha256": "409ba586de111e01c7a29196fc6f73fc9b587a3c77a2b1142a11bdd8ceaa73b6",
              "content": "[mcp_servers.agent_harness]\ncommand = \"./bin/agent-harness\"\nargs = [\"mcp\"]\nstartup_timeout_sec = 30\n\n[mcp_servers.agent_harness.env]\nHARNESS_ROOT = \".\"\n"
            },
            {
              "kind": "codex_user_hooks_config",
              "path": "$CODEX_HOME/hooks.json",
              "written": true,
              "content_sha256": "79a387b92fd771c53cfb647a589fbb83e86ef56c85ee6e31924ed4cc062ad8ce",
              "content": "{\n  \"hooks\": {\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$BIN' hook user-prompt\",\n            \"timeout\": 5,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ]\n  }\n}\n"
            },
            {
              "kind": "codex_user_mcp_config",
              "path": "$CODEX_HOME/config.toml",
              "written": true,
              "content_sha256": "a2c0a91dc8dd967983100a4990b1b59ddb502a08367c83d4254debfb99bcec00",
              "content": "[mcp_servers.agent_harness]\ncommand = \"$BIN\"\nargs = [\"mcp\"]\nstartup_timeout_sec = 30\n\n[mcp_servers.agent_harness.env]\nHARNESS_ROOT = \"$ROOT\"\n"
            }
          ],
          "links": [
            {
              "path": "$CODEX_HOME/skills/alpha",
              "target": "$ROOT/skills/alpha",
              "created": true,
              "resolves_to_root_skill": true
            },
