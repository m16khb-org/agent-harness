              "content": "[mcp_servers.agent_harness]\ncommand = \"$BIN\"\nargs = [\"mcp\"]\nstartup_timeout_sec = 30\n\n[mcp_servers.agent_harness.env]\nHARNESS_ROOT = \"$ROOT\"\n"
            }
